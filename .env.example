# Valeurs publiques : disponibles dans le navigateur.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Valeur serveur uniquement. À définir aussi dans les variables Vercel,
# jamais avec le préfixe NEXT_PUBLIC_. Utilisez l'une des deux clés.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
